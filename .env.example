# Copy this file to .env and fill in your keys. Never commit .env.
ANTHROPIC_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=secop-taller1-[team-name]
# Do NOT set LANGSMITH_AGENT_ID or LANGSMITH_AGENT_ENVIRONMENT together with LANGSMITH_PROJECT:
# LangSmith then does not know where to send the traces and records no tokens or cost.
# secop_agent.settings.load_environment() removes them at startup.

# Team name, used in result reports (the Colab notebook sets LANGSMITH_PROJECT=secop-taller1-<team>).
TEAM_NAME=

# Agent model (provider:model format). For another provider install its LangChain package,
# e.g. langchain-openai, and use openai:<model>.
MODEL=anthropic:claude-haiku-5-5
# Optional: model of the LLM judge in secop_agent.evaluate_qa (default: anthropic:claude-haiku-5-5).
# JUDGE_MODEL=anthropic:claude-haiku-5-5

# Q&A agent configuration: A = course's original prompt and descriptions (baseline) | B = improved
AGENT_CONFIG=B

# sample = the 20 local processes (needed for the reference set) | api = live data from datos.gov.co
DATA_MODE=sample
# Optional: free datos.gov.co app token for a higher query quota.
SOCRATA_APP_TOKEN=
