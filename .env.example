# Copien este archivo como .env y completen sus claves. Nunca suban .env al repositorio.
ANTHROPIC_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=secop-taller1-[nombre-del-equipo]

# Modelo del agente (formato proveedor:modelo). Para otro proveedor instalen su paquete,
# por ejemplo langchain-openai, y usen openai:<modelo>.
MODELO=anthropic:claude-haiku-5-5

# muestra = 20 procesos locales (para el conjunto de referencia) | api = datos.gov.co en vivo
MODO_DATOS=muestra
# Opcional: app token gratuito de datos.gov.co para más consultas
SOCRATA_APP_TOKEN=
